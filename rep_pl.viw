 --START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT GC.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GP.TYPE, ISNULL(P.RM,0), P.RATE
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 AND GC.GLGROUP IN ( 'SALES', 'CSALES', 'COGS','OCOGS', 'PUR', 'OI', 'EXP')

DROP VIEW [REP_PL]

CREATE VIEW [REP_PL] AS
SELECT GCDESCRIPT,[DATE],ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'SALES' AS TITLE , 'P' AS STATUS, 'SALES' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'SALES'
GROUP BY ALL GCDESCRIPT,[DATE]
UNION ALL
SELECT 'CREDIT SALES',[DATE],ISNULL(SUM(ISNULL(AMOUNT*-1 ,0)),0) AS AMOUNT , 'CREDIT SALES', 'P' , 'CREDIT SALES' 
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CSALES'
GROUP BY ALL GCDESCRIPT,[DATE]
UNION ALL
SELECT GCDESCRIPT,[DATE],ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'COST OF SALES' , 'L' , 'LESS: COST OF SALES'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('COGS','OCOGS')
GROUP BY ALL GCDESCRIPT,[DATE]
UNION ALL
SELECT 'CREDIT PURCHASE',[DATE],ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'COST OF SALES', 'L' , 'LESS: COST OF SALES' 
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PUR'
GROUP BY ALL GCDESCRIPT,[DATE]
UNION ALL
SELECT GCDESCRIPT,[DATE],ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'OTHER INCOME' , 'P' , 'OTHER INCOME'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'OI'
GROUP BY ALL GCDESCRIPT,[DATE]
UNION ALL
SELECT GCDESCRIPT,[DATE],ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'EXPENSES' , 'L' , 'LESS: EXPENSES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'EXP'
GROUP BY ALL GCDESCRIPT,[DATE]

