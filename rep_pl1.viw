--START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT GC.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GP.TYPE, ISNULL(P.RM,0), P.RATE
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 

DROP VIEW [REP_PL]

CREATE VIEW [REP_PL] AS
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1 ,0)),0) AS AMOUNT , 'PRODUCTION SALES' AS TITLE, 'P' AS STATUE, 'PRODUCTION SALES' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'PRODUCTION SALES' , 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'RI'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'COST OF SALES' , 'P', 'COST OF SALES'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('OS', 'COS')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'COST OF SALES', 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'COST OF PRODUCTION TRANSFERED FROM MANUFACTURING A/C', 'P', 'COST OF PRODUCTION TRANSFERED FROM MANUFACTURING A/C'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('ROS', 'RP', 'RCS', 'CGOS', 'CGP', 'CGCS', 'PMOS', 'PMP', 'PMCS', 'DL', 'PO', 'WIPOS', 'WIPCS')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1 ,0)),0), 'OI', 'P', 'OI'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'OI'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0) , 'ADMINISTRATIVE & GENERAL EXPENSES', 'L', 'LESS:ADMINISTRATIVE & GENERAL EXPENSES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'AGE'
GROUP BY ALL GCDESCRIPT, [DATE]

