##

DROP VIEW [REP_TRIALBAL]

CREATE VIEW REP_TRIBAL AS
SELECT A.GLCODE, SUM(A.BF) AS BF, SUM(A.YTD) AS YTD FROM
(
SELECT GLCODE,SUM(AMOUNT) AS BF, 0 AS YTD
FROM PGCODE
WHERE DATE < @two1
GROUP BY GLCODE
UNION ALL
SELECT GLCODE, 0, SUM(AMOUNT) 
FROM PGCODE
WHERE DATE <= @two2
GROUP BY GLCODE ) A
GROUP BY A.GLCODE


--End of file