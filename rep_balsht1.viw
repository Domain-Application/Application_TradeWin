--START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT GC.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GC.TYPE, ISNULL(P.RM,0), P.RATE
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 

DROP VIEW [REP_BALSHT]

CREATE VIEW [REP_BALSHT] AS
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0) AS AMOUNT , 'FIXED ASSETS' AS TITLE, 'P' AS STATUE, 'FIXED ASSETS' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'FA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'FIXED ASSETS' , 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'FDP'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS', 'L', 'OTHER DEBTORS, DEPOSIT, STAFF LOAN:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'ODS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS', 'L1', 'CASH & BANK BALANCE:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CB'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'P', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CL'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'OTHER CREDITORS & ACCRUALS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'OCA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L1', 'HIRE PURCHASE CREDITORS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'HPC'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L2', 'DIRECTORS ACCOUNT:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'DA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT 'NET CURRENT ASSETS(LIABILITIES)', [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'NET CURRENT ASSETS(LIABILITIES)', 'P', 'NET CURRENT ASSETS(LIABILITIES)'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('FA', 'FDP', 'CA', 'ODS', 'CB','CL', 'OCA', 'HPC', 'DA')
GROUP BY [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'EXPENDITURE CARRIED FORWARD - AT COST', 'P', 'EXPENDITURE CARRIED FORWARD - AT COST'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PE'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'SHARE CAPITAL', 'P', 'SHARE CAPITAL'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('STL','SC', 'RESERV')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT 'PROFIT/(LOSS) FOR THE YEAR', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'SHARE CAPITAL', 'P', 'SHARE CAPITAL'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('PS', 'RI', 'ROS', 'RP', 'RCS', 'CGOS', 'CGP', 'CGCS', 'PMOS', 'PMP', 'PMCS', 'DL', 'PO', 'WIPOS', 'WIPCS', 'OS', 'COS', 'CS', 'OI', 'AGE')
GROUP BY [DATE]

