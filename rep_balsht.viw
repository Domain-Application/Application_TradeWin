WHERE GLGROUP = 'BANK'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CL'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Director Account', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'DA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Trade Creditors', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'TC'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Other Creditors', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'OC'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Bank Account', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CBANK'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'HP Creditors', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS CURRENT LIABILITIES', 'L', 'LESS CURRENT LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'HP'
