--Start file

##

DROP VIEW [Sales_Invoice]

CREATE VIEW [Sales_Invoice]
AS
SELECT dbo.AROINV_WB_HQ.AMOUNT, dbo.ARINV_HQ.[DATE], dbo.ARINV_HQ.ACCODE, dbo.ARINV_HQ.INVOICE
FROM dbo.ARINV_HQ LEFT OUTER JOIN
dbo.AROINV_WB_HQ ON dbo.ARINV_HQ.INVOICE = dbo.AROINV_WB_HQ.INVOICE
WHERE DATE>=@two1 AND DATE<=@two2

DROP VIEW [Despatch_Ticket]

CREATE VIEW [Despatch_Ticket]
AS
SELECT TICKET, [DATE], ACCODE, AMT1, AMT2, AMT3, AMT4, AMT6, AMT5, AMT7, AMT8, AMT11, AMT12, AMT13, AMT14, AMT15, AMT18, AMT17, AMT16
FROM dbo.DP_HQ
WHERE DATE>=@two1 AND DATE<=@two2

DROP VIEW [Purchase_Invoice]

CREATE VIEW [Purchase_Invoice]
AS
SELECT dbo.APINV_HQ.INVOICE, dbo.APINV_HQ.[DATE], dbo.APINV_HQ.ACCODE, dbo.APOINV_WB_HQ.AMOUNT
FROM dbo.APINV_HQ LEFT OUTER JOIN
dbo.APOINV_WB_HQ ON dbo.APINV_HQ.INVOICE = dbo.APOINV_WB_HQ.INVOICE
WHERE DATE>=@two1 AND DATE<=@two2

DROP VIEW [Receive_Ticket]

CREATE VIEW [Receive_Ticket]
AS
SELECT TICKET, [DATE], ACCODE, AMT1, AMT2, AMT3, AMT4, AMT5, AMT6, AMT7, AMT8, AMT11, AMT12, AMT13, AMT14, AMT15, AMT16, AMT17, AMT18
FROM dbo.DS_HQ
WHERE DATE>=@two1 AND DATE<=@two2

--End file