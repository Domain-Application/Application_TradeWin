UNION ALL

SELECT 'Banker Acceptance', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS LONG-TERM LIABILITIES', 'L', 'LESS LONG-TERM LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'LL'
