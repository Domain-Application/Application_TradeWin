--Strat of file

##

DELETE [TMP_PGCODE]

INSERT INTO [TMP_PGCODE]
SELECT GLCODE, [DATE], REFNO, PARTICULAR, AMOUNT, PATH,	TYPE, BANKIN, CHEQUE, PCCODE, RATE, RM 
FROM PGCODE 
WHERE [DATE] <= @two2

DROP VIEW [REP_ROGLIST]

CREATE VIEW [REP_ROGLIST] AS
SELECT G.GLCODE, [DATE],REFNO, PARTICULAR, CREDIT, DEBIT, CHEQUE, G.DESCRIPT, G.GLGROUP, G.TYPE
FROM(
SELECT PGCODE.GLCODE, PGCODE.[DATE],PGCODE.REFNO, PGCODE.PARTICULAR, PGCODE.AMOUNT * RATE  AS CREDIT, 0 AS DEBIT, PGCODE.CHEQUE 
FROM TMP_PGCODE PGCODE
WHERE AMOUNT < 0
UNION ALL
SELECT PGCODE.GLCODE, PGCODE.[DATE],PGCODE.REFNO, PGCODE.PARTICULAR, 0 , PGCODE.AMOUNT * RATE  AS DEBIT, PGCODE.CHEQUE 
FROM TMP_PGCODE PGCODE
WHERE AMOUNT > 0
)A LEFT OUTER JOIN GLCODE G ON A.GLCODE = G.[PRIMARY]
WHERE [DATE] BETWEEN @two1 AND @two2
UNION ALL
SELECT G.GLCODE, @two1 , NULL, 'BALANCES BROUGHT FORWARD', SUM(CREDIT), SUM(DEBIT), NULL, G.DESCRIPT, G.GLGROUP, G.TYPE
FROM(
SELECT PGCODE.GLCODE, PGCODE.[DATE],PGCODE.REFNO, PGCODE.PARTICULAR, PGCODE.AMOUNT * RATE  AS CREDIT, 0 AS DEBIT, PGCODE.CHEQUE 
FROM TMP_PGCODE PGCODE
WHERE AMOUNT < 0
UNION ALL
SELECT PGCODE.GLCODE, PGCODE.[DATE],PGCODE.REFNO, PGCODE.PARTICULAR, 0 , PGCODE.AMOUNT * RATE  AS DEBIT, PGCODE.CHEQUE 
FROM TMP_PGCODE PGCODE
WHERE AMOUNT > 0
)A LEFT OUTER JOIN GLCODE G ON A.GLCODE = G.[PRIMARY]
WHERE [DATE] < @two1
GROUP BY G.GLCODE, G.DESCRIPT, G.GLGROUP, G.TYPE

--End of file