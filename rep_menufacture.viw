--START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT P.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GP.ACCCAT, P.AMOUNT
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 

DROP VIEW [REP_PL]

CREATE VIEW [REP_PL] AS
SELECT GCDESCRIPT, SUM(AMOUNT) , 'RAW MATERIAL' AS TITLE, 'P' AS STATUE, 'RAW MATERIAL' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('ROS', 'RP')
GROUP BY GCDESCRIPT
UNION ALL
SELECT GCDESCRIPT, SUM(AMOUNT) , 'RAW MATERIAL' AS TITLE, 'L' AS STATUE, 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'RCS'
GROUP BY GCDESCRIPT
UNION ALL 
SELECT GCDESCRIPT, SUM(AMOUNT) , 'CONSUMABLE GOODS & TOOLS' AS TITLE, 'P' AS STATUE, 'CONSUMABLE GOODS & TOOLS' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('CGOS', 'CGP')
GROUP BY GCDESCRIPT
UNION ALL
SELECT GCDESCRIPT, SUM(AMOUNT) , 'CONSUMABLE GOODS & TOOLS' AS TITLE, 'L' AS STATUE, 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CGCS'
GROUP BY GCDESCRIPT
UNION ALL 
SELECT GCDESCRIPT, SUM(AMOUNT) , 'PACKING MATERIAL' AS TITLE, 'P' AS STATUE, 'PACKING MATERIAL' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('PMOS', 'PMP')
GROUP BY GCDESCRIPT
UNION ALL
SELECT GCDESCRIPT, SUM(AMOUNT) , 'PACKING MATERIAL' AS TITLE, 'L' AS STATUE, 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PMCS'
GROUP BY GCDESCRIPT
UNION ALL 
SELECT GCDESCRIPT, SUM(AMOUNT) , 'DIRECT LABOUR' AS TITLE, 'P' AS STATUE, 'DIRECT LABOUR' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'DL'
GROUP BY GCDESCRIPT
UNION ALL 
SELECT GCDESCRIPT, SUM(AMOUNT) , 'PRODUCTION OVERHEAD' AS TITLE, 'P' AS STATUE, 'PRODUCTION OVERHEAD' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PO'
GROUP BY GCDESCRIPT
UNION ALL 
SELECT GCDESCRIPT, SUM(AMOUNT) , 'WORK-IN-PROGRESS' AS TITLE, 'P' AS STATUE, 'WORK-IN-PROGRESS' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'WIPOS'
GROUP BY GCDESCRIPT
UNION ALL
SELECT GCDESCRIPT, SUM(AMOUNT) , 'WORK-IN-PROGRESS' AS TITLE, 'L' AS STATUE, 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'WIPCS'
GROUP BY GCDESCRIPT