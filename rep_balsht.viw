UNION ALL

SELECT 'Term Loan', [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'LESS LONG-TERM LIABILITIES', 'L', 'LESS LONG-TERM LIABILITIES'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'LOAN'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'FINANCED BY', 'P', 'FINANCED BY'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('SC', 'RESERV')
GROUP BY ALL GCDESCRIPT, [DATE]

