--START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT GC.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GC.TYPE, ISNULL(P.RM,0), P.RATE
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 

DROP VIEW [REP_BALSHT]

CREATE VIEW [REP_BALSHT] AS
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0) AS AMOUNT , 'FIXED ASSETS' AS TITLE, 'P' AS STATUE, 'FIXED ASSETS' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'FA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT * -1,0)),0), 'FIXED ASSETS' , 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'FDP'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 

SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0) AS AMOUNT , 'INTANGIBLE ASSETS' AS TITLE, 'P' AS STATUE, 'INTANGIBLE ASSETS' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP = 'INTAN'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CA'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Other Debtors', [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'OD'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Advances', [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'ADV'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Sundry Deposit', [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'SDYD'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL

SELECT 'Petty Cash', [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CURRENT ASSETS' , 'P', 'CURRENT ASSETS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CASH'
