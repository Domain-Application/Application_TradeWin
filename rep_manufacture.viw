--START FILE

@date1
please key in data of statement
Statement date:

DELETE [TMP_FINANCIAL]

INSERT INTO [TMP_FINANCIAL]
SELECT GC.GLCODE, GC.DESCRIPT, GC.GLGROUP, GP.DESCRIPT, P.[DATE], GP.TYPE, P.RM, P.RATE
FROM PGCODE P LEFT OUTER JOIN GLCODE GC ON P.GLCODE = GC.[PRIMARY]
	      LEFT OUTER JOIN GLGROUP GP ON GC.GLGROUP = GP.CODE
WHERE [DATE] <= @date1 

DROP VIEW [REP_manufacture]

CREATE VIEW [REP_manufacture] AS
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0) AS AMOUNT , 'RAW MATERIAL' AS TITLE, 'P' AS STATUE, 'RAW MATERIAL' AS [NAME]
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('ROS', 'RP')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'RAW MATERIAL' , 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'RCS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT ,0)),0), 'CONSUMABLE GOODS & TOOLS' , 'P', 'CONSUMABLE GOODS & TOOLS'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('CGOS', 'CGP')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'CONSUMABLE GOODS & TOOLS', 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'CGCS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'PACKING MATERIAL', 'P', 'PACKING MATERIAL'
FROM TMP_FINANCIAL
WHERE GLGROUP IN ('PMOS', 'PMP')
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'PACKING MATERIAL', 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PMCS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'DIRECT LABOUR', 'P', 'DIRECT LABOUR'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'DL'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'PRODUCTION OVERHEAD', 'P', 'PRODUCTION OVERHEAD'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'PO'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL 
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0), 'WORK-IN-PROGRESS', 'P', 'WORK-IN-PROGRESS'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'WIPOS'
GROUP BY ALL GCDESCRIPT, [DATE]
UNION ALL
SELECT GCDESCRIPT, [DATE], ISNULL(SUM(ISNULL(AMOUNT,0)),0) , 'WORK-IN-PROGRESS', 'L', 'LESS:'
FROM TMP_FINANCIAL
WHERE GLGROUP = 'WIPCS'
GROUP BY ALL GCDESCRIPT, [DATE]

