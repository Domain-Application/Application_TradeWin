--Start of file

##

drop view [REP_AGEING]

create view [REP_AGEING] as
SELECT REFNO, B.CODE AS DEBTOR, [DATE], AMOUNT, PAYTOTAL, CNTOTAL, [NAME], RATE, 'N' AS TYPE, PAYOVER, CNOVER
FROM(
SELECT REFNO, debtor, [DATE], ISNULL(AMOUNT, 0) AS Amount, 0 AS PAYTOTAL, 0 AS CNTOTAL, /*
                   (SELECT ISNULL(SUM(ISNULL(ARPAYDAT.TOTAL, 0)), 0)
                    FROM   ARPAYDAT
                    WHERE ARPAYDAT.INVOICE = ARINV.REFNO AND ARPAYDAT.[DATE] BETWEEN @two1 AND @two2) AS PAYTOTAL,
                   (SELECT ISNULL(SUM(ISNULL(ARCRDAT.TOTAL, 0)), 0)
                    FROM   ARCRDAT
                    WHERE ARCRDAT.INVOICE = ARINV.REFNO AND ARCRDAT.[DATE] BETWEEN @two1 AND @two2) AS CNTOTAL,*/
                    RATE, 0 AS PAYOVER, 0 AS CNOVER
FROM  ARINV 
WHERE [DATE]BETWEEN @two1 AND @two2 /* and amount <>
                   (SELECT ISNULL(SUM(ISNULL(ARPAYDAT.TOTAL, 0)), 0)
                    FROM   ARPAYDAT
                    WHERE ARPAYDAT.INVOICE = ARINV.REFNO AND ARPAYDAT.[DATE] BETWEEN @two1 AND @two2)  + 
                   (SELECT ISNULL(SUM(ISNULL(ARCRDAT.TOTAL, 0)), 0)
                    FROM   ARCRDAT
                    WHERE ARCRDAT.INVOICE = ARINV.REFNO AND ARCRDAT.[DATE] BETWEEN @two1 AND @two2) */
UNION ALL
SELECT dbo.ARIPAY.REFNO, dbo.ARIPAY.debtor, dbo.ARIPAY.[DATE], 0 AS AMOUNT,
               dbo.ARIPAY.AMOUNT/* - SUM(ISNULL(dbo.ARPAYDAT.TOTAL, 0)) */AS PAYTOTAL, 0 AS CNTOTAL,
               RATE, 0, 0
FROM  dbo.ARIPAY LEFT OUTER JOIN
               dbo.ARPAYDAT ON dbo.ARIPAY.REFNO = dbo.ARPAYDAT.REFNO
WHERE ((dbo.ARPAYDAT.[DATE] BETWEEN @two1 AND @two2) OR
               (dbo.ARPAYDAT.[DATE] IS NULL) ) and dbo.ARIPAY.[DATE] BETWEEN @two1 AND @two2
GROUP BY dbo.ARIPAY.REFNO, dbo.ARIPAY.debtor, dbo.ARIPAY.[DATE], dbo.ARIPAY.AMOUNT, RATE
/*HAVING (dbo.ARIPAY.AMOUNT <> SUM(ISNULL(dbo.ARPAYDAT.TOTAL, 0)))*/
UNION ALL
SELECT dbo.ARCR.REFNO, dbo.ARCR.debtor, dbo.ARCR.[DATE], 0 AS AMOUNT, 0 AS PAYTOTAL,
               dbo.ARCR.AMOUNT /*- SUM(ISNULL(dbo.ARCRDAT.TOTAL, 0))*/ AS CNTOTAL, RATE, 0, 0
FROM  dbo.ARCR LEFT OUTER JOIN
               dbo.ARCRDAT ON dbo.ARCR.REFNO = dbo.ARCRDAT.REFNO
        inner join debtor on arcr.debtor = debtor.code
WHERE ((dbo.ARCRDAT.[DATE] BETWEEN @two1 AND @two2) OR
               (dbo.ARCRDAT.[DATE] IS NULL)  ) and dbo.ARcr.[DATE] BETWEEN @two1 AND @two2
GROUP BY dbo.ARCR.REFNO, dbo.ARCR.debtor, dbo.ARCR.[DATE], dbo.ARCR.AMOUNT, RATE
UNION ALL
SELECT REFNO, DEBTOR, [DATE], 0, 0, 0, RATE, isnull(AMOUNT,0) - isnull((SELECT SUM(isnull(TOTAL,0)) 
FROM ARPAYDAT C LEFT OUTER JOIN ARINV D ON C.INVOICE = D.REFNO
WHERE D.[DATE]<= @two2 AND C.REFNO = ARIPAY.REFNO),0) AS PAYOVER, 0 
FROM ARIPAY
where [DATE] BETWEEN @two1 AND @two2
group by REFNO, DEBTOR, [DATE], RATE, AMOUNT
HAVING isnull(AMOUNT,0) -  isnull((SELECT SUM(isnull(TOTAL,0)) 
FROM ARPAYDAT C LEFT OUTER JOIN ARINV D ON C.INVOICE = D.REFNO
WHERE D.[DATE]<= @two2 AND C.REFNO = ARIPAY.REFNO),0) > 0
UNION ALL
SELECT REFNO, DEBTOR, [DATE], 0, 0, 0, RATE, 0, isnull(AMOUNT,0) - isnull((SELECT SUM(isnull(TOTAL,0)) 
FROM ARCRDAT C LEFT OUTER JOIN ARINV D ON C.INVOICE = D.REFNO
WHERE D.[DATE]<= @two2 AND C.REFNO = ARCR.REFNO),0) AS CROVER
FROM ARCR
where [DATE] BETWEEN @two1 AND @two2
group by REFNO, DEBTOR, [DATE], RATE, AMOUNT
HAVING isnull(AMOUNT,0) -  isnull((SELECT SUM(isnull(TOTAL,0)) 
FROM ARCRDAT C LEFT OUTER JOIN ARINV D ON C.INVOICE = D.REFNO
WHERE D.[DATE]<= @two2 AND C.REFNO = ARCR.REFNO),0) > 0
)A INNER JOIN DEBTOR B ON A.DEBTOR = B.CODE
UNION ALL
SELECT REFNO, B.CODE AS DEBTOR, [DATE], AMOUNT, PAYTOTAL, CNTOTAL, [NAME], RATE, 'B' AS TYPE, PAYOVER, CNOVER
FROM(
SELECT REFNO, debtor, [DATE], ISNULL(AMOUNT, 0) AS Amount,
                   (SELECT ISNULL(SUM(ISNULL(ARPAYDAT.TOTAL, 0)), 0)
                    FROM   ARPAYDAT
                    WHERE ARPAYDAT.INVOICE = ARINV.REFNO AND ARPAYDAT.[DATE] <= @two2) AS PAYTOTAL,
                   (SELECT ISNULL(SUM(ISNULL(ARCRDAT.TOTAL, 0)), 0)
                    FROM   ARCRDAT
                    WHERE ARCRDAT.INVOICE = ARINV.REFNO AND ARCRDAT.[DATE] <= @two2) AS CNTOTAL,
                    RATE, 0 AS PAYOVER, 0 AS CNOVER
FROM  ARINV 
WHERE [DATE] <= @two2 and amount <>
                   (SELECT ISNULL(SUM(ISNULL(ARPAYDAT.TOTAL, 0)), 0)
                    FROM   ARPAYDAT
                    WHERE ARPAYDAT.INVOICE = ARINV.REFNO AND ARPAYDAT.[DATE] <= @two2)  + 
                   (SELECT ISNULL(SUM(ISNULL(ARCRDAT.TOTAL, 0)), 0)
                    FROM   ARCRDAT
                    WHERE ARCRDAT.INVOICE = ARINV.REFNO AND ARCRDAT.[DATE] <= @two2) 
UNION ALL
SELECT dbo.ARIPAY.REFNO, dbo.ARIPAY.debtor, dbo.ARIPAY.[DATE], 0 AS AMOUNT,
               dbo.ARIPAY.AMOUNT - SUM(ISNULL(dbo.ARPAYDAT.TOTAL, 0)) AS PAYTOTAL, 0 AS CNTOTAL,
               RATE, 0, 0
FROM  dbo.ARIPAY LEFT OUTER JOIN
               dbo.ARPAYDAT ON dbo.ARIPAY.REFNO = dbo.ARPAYDAT.REFNO
WHERE ((dbo.ARPAYDAT.[DATE] <= @two2) OR
               (dbo.ARPAYDAT.[DATE] IS NULL) ) and dbo.ARIPAY.[DATE] <= @two2
GROUP BY dbo.ARIPAY.REFNO, dbo.ARIPAY.debtor, dbo.ARIPAY.[DATE], dbo.ARIPAY.AMOUNT, RATE
HAVING (dbo.ARIPAY.AMOUNT <> SUM(ISNULL(dbo.ARPAYDAT.TOTAL, 0)))
UNION ALL
SELECT dbo.ARCR.REFNO, dbo.ARCR.debtor, dbo.ARCR.[DATE], 0 AS AMOUNT, 0 AS PAYTOTAL,
               dbo.ARCR.AMOUNT - SUM(ISNULL(dbo.ARCRDAT.TOTAL, 0)) AS CNTOTAL, RATE, 0, 0
FROM  dbo.ARCR LEFT OUTER JOIN
               dbo.ARCRDAT ON dbo.ARCR.REFNO = dbo.ARCRDAT.REFNO
        inner join debtor on arcr.debtor = debtor.code
WHERE ((dbo.ARCRDAT.[DATE] <= @two2) OR
               (dbo.ARCRDAT.[DATE] IS NULL)  ) and dbo.ARcr.[DATE] <= @two2
GROUP BY dbo.ARCR.REFNO, dbo.ARCR.debtor, dbo.ARCR.[DATE], dbo.ARCR.AMOUNT, RATE
HAVING (dbo.ARCR.AMOUNT <> SUM(ISNULL(dbo.ARCRDAT.TOTAL, 0)))
)A INNER JOIN DEBTOR B ON A.DEBTOR = B.CODE

-- End of file